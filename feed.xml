---
layout: null
permalink: /feed.xml
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
{% comment %}Adapted from jekyll-feed 0.17.0 (MIT), with typed image metadata and a feed icon. License: assets/licenses/jekyll-feed.txt. Keep the feed/entry IDs and dates stable.{% endcomment %}
<feed xmlns="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/" xml:lang="{{ site.lang | default: 'en' | xml_escape }}">
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <link href="{{ '/feed.xml' | absolute_url | xml_escape }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/' | absolute_url | xml_escape }}" rel="alternate" type="text/html" hreflang="{{ site.lang | default: 'en' | xml_escape }}" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ '/feed.xml' | absolute_url | xml_escape }}</id>
  <title type="html">{{ site.title | xml_escape }} | {{ site.short_title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <icon>{{ '/assets/images/favicon.png' | absolute_url | xml_escape }}</icon>
  {% assign site_author = site.data.authors[site.author] | default: site.author %}
  <author><name>{{ site_author.name | default: site_author | xml_escape }}</name>{% if site_author.uri %}<uri>{{ site_author.uri | xml_escape }}</uri>{% endif %}</author>
  {% assign posts = site.posts | where_exp: 'post', 'post.draft != true' | sort: 'date' | reverse %}
  {% assign posts_limit = site.feed.posts_limit | default: 50 %}
  {% for post in posts limit: posts_limit %}
  <entry{% if post.lang %} xml:lang="{{ post.lang | xml_escape }}"{% endif %}>
    <title type="html">{{ post.title | smartify | strip_html | normalize_whitespace | xml_escape }}</title>
    <link href="{{ post.url | absolute_url | xml_escape }}" rel="alternate" type="text/html" title="{{ post.title | strip_html | xml_escape }}" />
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <id>{{ post.id | absolute_url | xml_escape }}</id>
    {% assign excerpt_only = post.feed.excerpt_only %}
    {% if excerpt_only == nil %}{% assign excerpt_only = site.feed.excerpt_only %}{% endif %}
    {% unless excerpt_only %}<content type="html" xml:base="{{ post.url | absolute_url | xml_escape }}">{{ post.content | strip | xml_escape }}</content>{% endunless %}
    {% assign post_author = post.author | default: post.authors[0] | default: site.author %}
    {% assign post_author = site.data.authors[post_author] | default: post_author %}
    <author><name>{{ post_author.name | default: post_author | xml_escape }}</name>{% if post_author.uri %}<uri>{{ post_author.uri | xml_escape }}</uri>{% endif %}</author>
    {% for category in post.categories %}<category term="{{ category | xml_escape }}" />{% endfor %}
    {% for tag in post.tags %}<category term="{{ tag | xml_escape }}" />{% endfor %}
    {% assign summary = post.description | default: post.excerpt %}
    {% if summary %}<summary type="html">{{ summary | strip_html | normalize_whitespace | xml_escape }}</summary>{% endif %}
    {% assign image_path = post.image.path | default: post.image %}
    {% assign image_type = post.image.type | default: '' %}
    {% if image_path %}
      {% if image_type == '' %}
        {% assign extension = image_path | split: '?' | first | split: '.' | last | downcase %}
        {% case extension %}
          {% when 'png' %}{% assign image_type = 'image/png' %}
          {% when 'jpg', 'jpeg' %}{% assign image_type = 'image/jpeg' %}
          {% when 'webp' %}{% assign image_type = 'image/webp' %}
          {% when 'avif' %}{% assign image_type = 'image/avif' %}
          {% when 'gif' %}{% assign image_type = 'image/gif' %}
          {% when 'svg' %}{% assign image_type = 'image/svg+xml' %}
        {% endcase %}
      {% endif %}
      {% if image_type != '' %}
    <media:thumbnail url="{{ image_path | absolute_url | xml_escape }}"{% if post.image.width %} width="{{ post.image.width }}"{% endif %}{% if post.image.height %} height="{{ post.image.height }}"{% endif %} />
    <media:content medium="image" type="{{ image_type | xml_escape }}" url="{{ image_path | absolute_url | xml_escape }}" />
      {% endif %}
    {% endif %}
  </entry>
  {% endfor %}
</feed>
